# Copy to /opt/magpie/.env and chmod 600. Generate secrets on the host; never commit the result.

# Image: a channel tag (daily, stable, latest) or a pinned version (ghcr.io/yetone/magpie:0.1.4526)
MAGPIE_IMAGE=ghcr.io/yetone/magpie:daily
MAGPIE_NAME=magpie
MAGPIE_PUBLIC_URL=https://magpie-api.example.com
MAGPIE_WEB_URL=https://magpie.example.com
MAGPIE_DRAIN=300
MAGPIE_LOCAL_PORT=3425

# openssl rand -hex 16
MAGPIE_WEB_KEY=
# `magpie gateway-key add edge-healthcheck --read-only` (step 4 of SKILL.md)
MAGPIE_HEALTH_KEY=
# Optional: a capped gateway key for the page-chat plugin
MAGPIE_GATEWAY_KEY=
# The remotely managed tunnel's token (references/cloudflare.md)
TUNNEL_TOKEN=
