# Copy to /opt/magpie/.env and chmod 600. Generate secrets on the host; never commit the result.

# Ingress: keep ONE line (SKILL.md, "Choose the ingress")
COMPOSE_FILE=compose.yaml:compose.cloudflare.yaml
# COMPOSE_FILE=compose.yaml:compose.tailscale.yaml
# COMPOSE_FILE=compose.yaml

# Image: a channel tag (daily, stable, latest) or a pinned version (ghcr.io/yetone/magpie:0.1.4697).
# Needs v0.1.4526 or later.
MAGPIE_IMAGE=ghcr.io/yetone/magpie:daily
MAGPIE_NAME=magpie
MAGPIE_DRAIN=300
MAGPIE_LOCAL_API_PORT=3425
MAGPIE_LOCAL_UI_PORT=3430

# External URLs.
#   Cloudflare: https://magpie.example.com and https://magpie-api.example.com
#   Tailscale:  https://magpie.<tailnet>.ts.net and https://magpie.<tailnet>.ts.net:8443
MAGPIE_WEB_URL=https://magpie.example.com
MAGPIE_PUBLIC_URL=https://magpie-api.example.com

# openssl rand -hex 16
MAGPIE_WEB_KEY=
# `magpie gateway-key add edge-healthcheck --read-only` (SKILL.md, step 4)
MAGPIE_HEALTH_KEY=
# Optional: a capped gateway key for the page-chat plugin (uncomment it in compose.yaml too)
MAGPIE_GATEWAY_KEY=

# Cloudflare ingress only: the tunnel token (references/cloudflare.md)
TUNNEL_TOKEN=

# Tailscale container ingress only (references/tailscale.md)
TS_HOSTNAME=magpie
TS_AUTHKEY=
